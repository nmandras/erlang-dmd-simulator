%% Example configuration with TLS enabled.
%% Generate self-signed certs first:  ./priv/certs/gen_certs.sh
%% Then run:  rebar3 shell --config config/sys.tls.config
[
 {dmd, [
   {mgmt_host, {127,0,0,1}},
   {mgmt_port, 5000},
   {device_port, 6000},
   {device_ip_first_octet, 2},
   {call_interval_ms, 10000},
   {reboot_duration_ms, 5000},

   {tls, true},
   {tls_opts, [
     {listen,  [{certfile, "priv/certs/server.pem"},
                {keyfile,  "priv/certs/server.key"}]},
     %% Self-signed certs: clients skip verification. For real CAs use
     %% {verify, verify_peer} and {cacertfile, "..."} instead.
     {connect, [{verify, verify_none}]}
   ]}
 ]}
].
