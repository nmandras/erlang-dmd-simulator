%% Example configuration with TLS enabled for both applications.
%% Generate self-signed certs first:  ./priv/certs/gen_certs.sh
%% Then run:  rebar3 shell --config config/sys.tls.config
[
 {kernel, [{logger_level, info}]},

 {dmd_agent, [
   {csv_file, "config/devices.csv"},
   {mgmt_host, {127,0,0,1}},
   {mgmt_port, 5000},
   {reboot_duration_ms, 5000},
   {log_file, "log/agent.log"},
   {tls, true},
   {tls_opts, [
     {listen,  [{certfile, "priv/certs/server.pem"},
                {keyfile,  "priv/certs/server.key"}]},
     {connect, [{verify, verify_none}]}
   ]}
 ]},

 {dmd_mgmt, [
   {csv_file, "config/devices.csv"},
   {mgmt_host, {127,0,0,1}},
   {mgmt_port, 5000},
   {log_file, "log/mgmt.log"},
   {driver_enabled, true},
   {driver_min_ms, 3000},
   {driver_max_ms, 8000},
   {tls, true},
   {tls_opts, [
     {listen,  [{certfile, "priv/certs/server.pem"},
                {keyfile,  "priv/certs/server.key"}]},
     {connect, [{verify, verify_none}]}
   ]}
 ]}
].
