%% Default (plain TCP) configuration for both applications.
%% See config/sys.tls.config for a TLS-enabled example.
[
 {kernel, [
   {logger_level, info}
 ]},

 {dmd_agent, [
   {csv_file, "config/devices.csv"},
   {mgmt_host, {127,0,0,1}},
   {mgmt_port, 5000},
   %% How devices time their periodic CALL within each period:
   %%   spread - random per-device offset, evenly distributing calls (default)
   %%   burst  - all devices call in step ("all at once")
   {call_dispatch, spread},
   %% Max simultaneous outbound TCP connections for periodic CALLs. Prevents
   %% `{error, system_limit}' when running large fleets (10k+ devices).
   {max_connect_inflight, 500},
   %% Probability (0.0..1.0) that a STAT reports SECSTAT:1 (security events
   %% pending), which makes the server follow up with a SECLOG.
   {secstat_probability, 1.0},
   {reboot_duration_ms, 5000},
   {log_file, "log/agent.log"},
   {tls, false},
   {tls_opts, []}
 ]},

 {dmd_mgmt, [
   {csv_file, "config/devices.csv"},
   {mgmt_host, {127,0,0,1}},
   {mgmt_port, 5000},
   {log_file, "log/mgmt.log"},
   %% On every CALL received, poll the calling device with a STAT command.
   {stat_on_call, true},
   {max_connect_inflight, 500},
   %% Autonomous command driver: fires a random command to a random device
   %% every driver_min_ms..driver_max_ms.
   {driver_enabled, true},
   {driver_min_ms, 3000},
   {driver_max_ms, 8000},
   {tls, false},
   {tls_opts, []}
 ]}
].
