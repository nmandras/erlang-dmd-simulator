%% Default (plain TCP) configuration for the dmd simulator.
%% See config/sys.tls.config for an example with TLS enabled.
[
 {dmd, [
   %% Mock management server bind address / port (devices dial this for CALLs)
   {mgmt_host, {127,0,0,1}},
   {mgmt_port, 5000},

   %% Port every simulated device listens on (each device has its own IP,
   %% so a single shared port is unambiguous).
   {device_port, 6000},

   %% First loopback octet used when auto-allocating device IPs:
   %% device i binds 127.0.0.(first_octet + i).
   {device_ip_first_octet, 2},

   %% Periodic CALL interval and simulated reboot duration (milliseconds).
   {call_interval_ms, 10000},
   {reboot_duration_ms, 5000},

   %% TLS is optional and off by default. When {tls, true}, both the
   %% management server and device listeners use ssl, and all client
   %% connections use ssl too. tls_opts carries listen-side and
   %% connect-side ssl options:
   %%   {tls_opts, [{listen,  [{certfile,"..."},{keyfile,"..."}]},
   %%               {connect, [{verify, verify_none}]}]}
   {tls, false},
   {tls_opts, []}
 ]}
].
