%% Large-fleet profile for Windows Server / 10k+ device simulators.
%%
%% Pair with:
%%   Start-All.ps1 -Scale
%%   Set-WindowsTcpTuning.ps1   (elevated, once per machine)
%%   Add-LoopbackAliases.ps1    (elevated, after generating the fleet CSV)
%%
%% Use a CALL period of at least 30s in the fleet CSV (Reptime column) so
%% spread dispatch keeps concurrent sockets within max_connect_inflight.
[
 {kernel, [
   {logger_level, info}
 ]},

 {dmd_agent, [
   {csv_file, "config/devices.csv"},
   {mgmt_host, {127,0,0,1}},
   {mgmt_port, 5000},
   {call_dispatch, spread},
   {max_connect_inflight, 1000},
   {secstat_probability, 0.0},
   {reboot_duration_ms, 5000},
   {log_file, "log/agent.log"},
   {tls, false},
   {tls_opts, []}
 ]},

 {dmd_mgmt, [
   {csv_file, "config/devices.csv"},
   {mgmt_host, {127,0,0,1}},
   {mgmt_port, 5000},
   {log_file, "log/mgmt.log"},
   %% Reverse STAT connections on every CALL roughly double socket pressure.
   {stat_on_call, false},
   {max_connect_inflight, 1000},
   {driver_enabled, false},
   {tls, false},
   {tls_opts, []}
 ]}
].
